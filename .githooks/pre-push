#!/usr/bin/env bash
#
# pre-push hook for dynamic-cli: runs the formatting and lint checks that
# CI would otherwise catch after the push.
#
# Opt-in, once per clone:
#     git config core.hooksPath .githooks
#
# Skip once (not recommended):
#     git push --no-verify

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

run() {
    echo "pre-push: $*"
    if ! "$@"; then
        echo
        echo "pre-push: failed: $*"
        echo "pre-push: fix the issues above, or push with --no-verify to skip"
        exit 1
    fi
}

run cargo fmt --all --check
run cargo clippy --all-features --all-targets -- -D warnings

echo "pre-push: all checks passed"
